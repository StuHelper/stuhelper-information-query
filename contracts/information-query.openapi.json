{
  "openapi": "3.0.3",
  "info": {
    "title": "StuHelper Information Query",
    "version": "0.2.0"
  },
  "paths": {
    "/api/v1/information-query/query": {
      "post": {
        "operationId": "queryInformation",
        "description": "Authenticated principal and delivery channel are supplied by trusted host middleware. Query values must not be logged. Sensitive data is released only after audit commits.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Query"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency or audit unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown route",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "POST"
                  ]
                }
              }
            }
          },
          "415": {
            "description": "Expected application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/information-query/audit/query": {
      "post": {
        "operationId": "queryInformationAudit",
        "description": "Authenticated principal and delivery channel are supplied by trusted host middleware. Query values must not be logged. Sensitive data is released only after audit commits.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditFilter"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency or audit unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown route",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "POST"
                  ]
                }
              }
            }
          },
          "415": {
            "description": "Expected application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/information-query/capabilities": {
      "post": {
        "operationId": "queryInformationCapabilities",
        "description": "Read-only preflight inspection of authorized and host-assembled information-query capabilities for the current principal and requested scope.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CapabilitiesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "schemas": {
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "school": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "module": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "school",
          "group",
          "module"
        ]
      },
      "Query": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "name",
              "student_id",
              "qq",
              "account"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Canonical platform issuer:subject key for account (up to 2048 ASCII bytes). Other clues allow up to 256 Unicode code points."
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "domains": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "profiles",
                "verification",
                "catalog",
                "reviews",
                "resources",
                "billing",
                "groups"
              ]
            }
          },
          "fields": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "identity",
                "document",
                "material",
                "refund_payee"
              ]
            },
            "description": "Sensitive categories explicitly requested; omitted means masked identity fields only."
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*$",
            "description": "Up to 512 Unicode code points. Line breaks and tabs are allowed."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Total returned domain records, across all candidate groups. Candidate groups are capped at 50; processing budget may produce a shorter page."
          },
          "after": {
            "type": "string",
            "maxLength": 4096,
            "description": "Opaque composite continuation for candidate and domain records; reuse only with the same query and principal. Stable exclusive pagination for unchanged source facts. Each request processes at most 50 candidates and 100 returned domain records; a short page can have a continuation. The server authenticates the cursor. Restart from page one if it is invalid. Field and domain selection order is insignificant."
          }
        },
        "required": [
          "kind",
          "value",
          "scope",
          "domains",
          "purpose",
          "limit"
        ],
        "not": {
          "properties": {
            "kind": {
              "not": {
                "enum": [
                  "account"
                ]
              }
            },
            "value": {
              "minLength": 257
            }
          }
        }
      },
      "Field": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "business",
              "identity",
              "document",
              "material",
              "refund_payee"
            ]
          },
          "value": {
            "type": "string"
          },
          "masked": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "category",
          "value",
          "masked"
        ]
      },
      "Record": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "source": {
            "type": "string"
          },
          "current": {
            "type": "boolean"
          },
          "changed_at": {
            "type": "string",
            "format": "date-time"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Field"
            }
          }
        },
        "required": [
          "id",
          "subject",
          "scope",
          "source",
          "current",
          "changed_at",
          "fields"
        ]
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "next_cursor": {
            "type": "string"
          },
          "unavailable_domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Authorized domains with no registered provider; consumers must show incomplete results."
          },
          "groups": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/CandidateGroup"
            }
          }
        },
        "required": [
          "groups",
          "next_cursor",
          "unavailable_domains"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "invalid_parameter",
              "invalid_scope",
              "school_required",
              "invalid_account_key",
              "cursor_mismatch",
              "candidate_changed",
              "payload_too_large",
              "bot_disabled",
              "bot_forbidden",
              "channel_forbidden",
              "domain_forbidden",
              "field_forbidden",
              "audit_forbidden",
              "unauthenticated",
              "auth_unavailable",
              "resolver_unavailable",
              "provider_unavailable",
              "audit_unavailable"
            ],
            "description": "Machine-readable failure cause for localized recovery guidance."
          },
          "domain": {
            "type": "string",
            "enum": [
              "profiles",
              "verification",
              "catalog",
              "reviews",
              "resources",
              "billing",
              "groups"
            ],
            "description": "Affected business domain when a domain check or provider failed; never echoes query values.",
            "x-enum-varnames": [
              "ErrorDomainProfiles",
              "ErrorDomainVerification",
              "ErrorDomainCatalog",
              "ErrorDomainReviews",
              "ErrorDomainResources",
              "ErrorDomainBilling",
              "ErrorDomainGroups"
            ]
          },
          "field": {
            "type": "string",
            "enum": [
              "identity",
              "document",
              "material",
              "refund_payee"
            ],
            "description": "Affected sensitive field category when field authorization failed; never echoes query values."
          }
        },
        "required": [
          "code"
        ]
      },
      "AuditFilter": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*$",
            "description": "Up to 512 Unicode code points. Line breaks and tabs are allowed. Recorded as the reason for inspection, separate from search filters."
          },
          "after": {
            "type": "string",
            "pattern": "^[0-9]*$",
            "description": "Empty starts at the newest audit ID. Continue toward older IDs using the exclusive next_cursor from the previous page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "actor": {
            "type": "string",
            "maxLength": 2048,
            "description": "Optional exact operator account key filter."
          },
          "target": {
            "type": "string",
            "maxLength": 2048,
            "description": "Optional target account key matched against recorded audit targets."
          },
          "action": {
            "type": "string",
            "maxLength": 128,
            "description": "Optional audit action filter."
          },
          "result": {
            "type": "string",
            "maxLength": 128,
            "description": "Optional execution result filter."
          },
          "channel": {
            "type": "string",
            "maxLength": 128,
            "description": "Optional delivery channel filter."
          },
          "created_from": {
            "type": "string",
            "format": "date-time",
            "description": "Optional inclusive lower bound on audit creation time."
          },
          "created_until": {
            "type": "string",
            "format": "date-time",
            "description": "Optional inclusive upper bound on audit creation time."
          }
        },
        "required": [
          "scope",
          "purpose",
          "after",
          "limit"
        ]
      },
      "Audit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "channel": {
            "type": "string",
            "enum": [
              "admin",
              "bot_private",
              "bot_group",
              "unknown"
            ]
          },
          "target_group": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "query",
              "query.rejected",
              "audit.query",
              "audit.rejected",
              "provider.query",
              "unknown"
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "success",
              "denied",
              "invalid_request",
              "unauthenticated",
              "unavailable",
              "unknown"
            ]
          },
          "count": {
            "type": "integer"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "identity",
                "document",
                "material",
                "refund_payee"
              ]
            }
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "actor",
          "request_id",
          "purpose",
          "scope",
          "channel",
          "target_group",
          "action",
          "result",
          "count",
          "targets",
          "fields",
          "basis",
          "created_at"
        ]
      },
      "AuditPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Audit"
            }
          },
          "next_cursor": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ]
      },
      "Candidate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "account": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "current": {
            "type": "boolean"
          },
          "changed_at": {
            "type": "string",
            "format": "date-time",
            "description": "For direct account lookup this is the first request time of the pagination chain. Resolved candidates use the source change time."
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "label": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Field"
            },
            "description": "Masked distinguishing fields only."
          }
        },
        "required": [
          "account",
          "source",
          "current",
          "changed_at",
          "scope",
          "label"
        ]
      },
      "CandidateGroup": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate": {
            "$ref": "#/components/schemas/Candidate"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Record"
            }
          }
        },
        "required": [
          "candidate",
          "items"
        ]
      },
      "CapabilitiesRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "allowed_domains": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "profiles",
                "verification",
                "catalog",
                "reviews",
                "resources",
                "billing",
                "groups"
              ],
              "x-enum-varnames": [
                "CapabilitiesAllowedDomainsProfiles",
                "CapabilitiesAllowedDomainsVerification",
                "CapabilitiesAllowedDomainsCatalog",
                "CapabilitiesAllowedDomainsReviews",
                "CapabilitiesAllowedDomainsResources",
                "CapabilitiesAllowedDomainsBilling",
                "CapabilitiesAllowedDomainsGroups"
              ]
            },
            "description": "Domains authorized for the current principal within the evaluated scope."
          },
          "allowed_fields": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "identity",
                "document",
                "material",
                "refund_payee"
              ],
              "x-enum-varnames": [
                "CapabilitiesAllowedFieldsIdentity",
                "CapabilitiesAllowedFieldsDocument",
                "CapabilitiesAllowedFieldsMaterial",
                "CapabilitiesAllowedFieldsRefundPayee"
              ]
            },
            "description": "Sensitive field categories authorized for the current principal across the evaluated scope."
          },
          "available_domains": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "profiles",
                "verification",
                "catalog",
                "reviews",
                "resources",
                "billing",
                "groups"
              ],
              "x-enum-varnames": [
                "CapabilitiesAvailableDomainsProfiles",
                "CapabilitiesAvailableDomainsVerification",
                "CapabilitiesAvailableDomainsCatalog",
                "CapabilitiesAvailableDomainsReviews",
                "CapabilitiesAvailableDomainsResources",
                "CapabilitiesAvailableDomainsBilling",
                "CapabilitiesAvailableDomainsGroups"
              ]
            },
            "description": "Domains with registered providers on the current host."
          },
          "available_kinds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "name",
                "student_id",
                "qq",
                "account"
              ],
              "x-enum-varnames": [
                "CapabilitiesAvailableKindsName",
                "CapabilitiesAvailableKindsStudentId",
                "CapabilitiesAvailableKindsQq",
                "CapabilitiesAvailableKindsAccount"
              ]
            },
            "description": "Query lead kinds currently supported on the host."
          },
          "audit_readable": {
            "type": "boolean",
            "description": "Whether the current principal may read audit logs in the evaluated scope on the current channel."
          },
          "bot_enabled": {
            "type": "boolean",
            "description": "Whether bot channel queries are enabled on the host and authorized for the principal in the evaluated scope."
          }
        },
        "required": [
          "scope",
          "allowed_domains",
          "allowed_fields",
          "available_domains",
          "available_kinds",
          "audit_readable",
          "bot_enabled"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
